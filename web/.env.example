# Web app settings. Copy to .env.local; every line is optional for local use.

# Where the engine answers (default http://127.0.0.1:8008).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8008

# The public URL of this site, used for absolute links and social previews.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build ONLY the project page (landing + /rehber), for hosting without an engine — this is how
# biosphere.bilalgurkansanli.com is built. Dashboard, capture and embed routes then redirect
# to the guide. Leave unset to run the full app locally.
# NEXT_PUBLIC_SITE_ONLY=1
