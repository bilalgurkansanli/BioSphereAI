# BioSphere AI engine — copy to `.env` and edit. Every key is optional; the value shown is
# the default that `biosphere/core/config.py` resolves when the key is absent.
# All settings are read from the environment with the BIOSPHERE_ prefix.

# ---------------------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------------------

# Shown in the OpenAPI title and the startup banner.
BIOSPHERE_APP_NAME="BioSphere AI Engine"

# "development" turns on verbose uvicorn logging; anything else is treated as production.
BIOSPHERE_ENV=development

# Bind address. Use 0.0.0.0 in Docker, 127.0.0.1 on a workstation.
BIOSPHERE_HOST=127.0.0.1
BIOSPHERE_PORT=8008

# Absolute URL this API is reachable at from the browser. Used when building embed links.
BIOSPHERE_PUBLIC_BASE_URL=http://127.0.0.1:8008

# Where the Next.js dashboard lives.
BIOSPHERE_WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------------------

# Origins allowed to call the *write* routes (/api/v1/properties, /scenes, /hotspots, /ai).
# JSON list. Keep this tight — these endpoints mutate data.
BIOSPHERE_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# The public read routes (/api/v1/public/**) and the /media mount always answer any origin:
# the player is embedded in third-party listing portals inside an iframe, and a cross-origin
# WebGL texture needs both `Access-Control-Allow-Origin` and `Cross-Origin-Resource-Policy`.
BIOSPHERE_CORS_ALLOW_ALL_PUBLIC_READS=true

# ---------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------

# Root of every byte this service writes: uploads/, properties/, work/, cache/, db/.
# Defaults to E:/biosphere-data or D:/biosphere-data when that drive exists, else <repo>/data.
# Panoramas are large; point this at a roomy volume.
# BIOSPHERE_MEDIA_ROOT=E:/biosphere-data

# URL prefix the property media is served under. Only <root>/properties is exposed publicly.
BIOSPHERE_MEDIA_URL_PREFIX=/media

# SQLAlchemy URL. Empty means sqlite in <media_root>/db/biosphere.db (WAL, foreign keys on).
# BIOSPHERE_DATABASE_URL=sqlite:///E:/biosphere-data/db/biosphere.db

# ---------------------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------------------

# Hard cap per uploaded file, enforced while streaming to disk (1.5 GiB, the engine's default).
# Keep it above what the guided capture can record: a limit under that is discovered only
# after a room has been filmed and uploaded.
BIOSPHERE_MAX_UPLOAD_BYTES=1610612736

# A capture shorter than this cannot contain a full turn of a room.
BIOSPHERE_MIN_VIDEO_SECONDS=5.0

# Longer captures blow up frame extraction without improving coverage.
BIOSPHERE_MAX_VIDEO_SECONDS=300.0

# Accepted containers. Uploads are additionally sniffed with ffprobe, never trusted by name.
BIOSPHERE_ALLOWED_VIDEO_SUFFIXES=[".mp4",".mov",".m4v",".avi",".mkv",".webm",".3gp"]
BIOSPHERE_ALLOWED_IMAGE_SUFFIXES=[".jpg",".jpeg",".png",".webp",".heic",".heif"]

# ---------------------------------------------------------------------------------------
# Processing
# ---------------------------------------------------------------------------------------

# Concurrent stitch jobs. A stitch saturates every core it is given, so >1 mainly helps when
# jobs are IO-bound on frame extraction. Raise only with RAM to spare (~4 GB per job).
BIOSPHERE_WORKER_CONCURRENCY=1

# Quality preset used when the upload form does not specify one: fast | balanced | studio.
BIOSPHERE_DEFAULT_QUALITY_MODE=balanced

# Binaries used for probing and frame extraction; absolute paths are fine.
BIOSPHERE_FFMPEG_BIN=ffmpeg
BIOSPHERE_FFPROBE_BIN=ffprobe

# Keep <media_root>/work/<job_id> after a run instead of deleting it. Debugging only —
# scratch directories are several GB each.
BIOSPHERE_KEEP_WORK_DIRS=false

# Allow CUDA use where the pipeline supports it, and report the GPU name in /health.
BIOSPHERE_ENABLE_GPU=true

# ---------------------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------------------

# Directory holding local model weights. Unset means the classical-CV paths only, which is
# what ships today (`model_backed: false` in every AI response).
# BIOSPHERE_AI_MODELS_DIR=E:/biosphere-data/models

# Whether the service may download model weights at runtime. Keep false on air-gapped hosts.
BIOSPHERE_AI_ALLOW_DOWNLOADS=false

# Where the GPU work for /ai/empty-room happens. Empty means "in this process".
#
# The models do not have to live where the service does, and on a workstation that is also
# somebody's desktop they should not: emptying a room is seconds of a whole GPU. Run
# `scripts/ai-worker.ps1` on the machine with the good card and point this at it. Only two
# model calls travel; the media root, the database and the job queue all stay here.
# BIOSPHERE_AI_WORKER_URL=http://192.168.1.42:8010

# Whether THIS process may load models onto its own GPU. Forced off whenever a worker URL is
# set — two copies of the same weights on two machines is what that setting exists to avoid.
BIOSPHERE_AI_LOCAL_MODELS=true

# Which model fills the room: auto | sd | lama.
#
# "auto" is LaMa when its weights are on this machine, and the classical per-surface fill when
# they are not. It NEVER picks the diffusion path, and that is a measurement rather than a
# preference: on a real photographed bedroom, Stable Diffusion inpainting draws a NEW BED into
# the bed-shaped hole instead of removing the old one, and at a 74 % mask it draws somebody
# else's flat — a window, a radiator, a vase of flowers. Guidance 6 to 15 and a negative prompt
# naming the furniture changed nothing. A generative inpainter answers "what belongs in this
# hole"; it cannot be asked for an absence.
#
# The classical fill has no vocabulary for objects and so cannot invent one. It is softer —
# a smooth wall, some drift across the floor — which is a defect a viewer forgives where an
# invented wardrobe is a misrepresentation.
#
# "sd" opts into the diffusion path anyway: reasonable for small removals, and for keeping a
# run off big-lama's non-commercial weights. Look at the output before publishing it.
# "lama" pins the reconstruction path and does not fall back.
BIOSPHERE_AI_INPAINTER=auto

# ---------------------------------------------------------------------------------------
# Listing copy (POST /api/v1/properties/{id}/listing)
# ---------------------------------------------------------------------------------------

# Key for the hosted model that writes a property's headline and description.
#
# This is the only part of the engine that leaves the building: one request carries the room
# names, the measured areas and up to six rendered room views to Anthropic. So it is off
# until a key is set. The easiest place is the dashboard: Ayarlar (/ayarlar) stores your own key in
# <media_root>/config/api_keys.json and wins over this line; here, or ANTHROPIC_API_KEY, works too.
# Never commit a real key — this project ships without one, and each user brings their own.
#
# With no key (or without `pip install -e ".[listing]"`) the endpoint still answers: the
# deterministic composer writes a plain, true paragraph from the same facts and the response
# says `model_backed: false`. See `biosphere/ai/listing.py`.
# BIOSPHERE_LISTING_API_KEY=sk-ant-...

# Which model writes it. Vision is required — the copy is written from the rooms' own
# pictures, not only from their names.
#
# Haiku is the default because this is a button pressed on every property: the same listing
# costs about 7-8 cents on claude-opus-5 and well under a cent on claude-haiku-4-5. The
# cheaper model writes a flatter paragraph, not a less truthful one — every number still comes
# from the measured FACTS block and `listing.audit` still checks each one. Pay for
# claude-sonnet-5 or claude-opus-5 if the sentence itself matters more than the bill.
BIOSPHERE_LISTING_MODEL=claude-haiku-4-5

# How many room views travel with one request. Sized by what a description can honestly use
# rather than by what fits: six rooms is more than any listing paragraph names, and every
# image is tokens on somebody's bill. The cover room goes first.
BIOSPHERE_LISTING_MAX_IMAGES=6

# Ceiling for one generation, including the upload of those images.
BIOSPHERE_LISTING_TIMEOUT_S=180.0

# ---------------------------------------------------------------------------------------
# Investment assistant (the "Yatırım" segment in the player; biosphere/invest/)
# ---------------------------------------------------------------------------------------

# A visitor on a published listing asks about rental yield, payback, the area's prices and a
# mortgage; the model searches the web for market data and every figure it states is computed
# by the engine's own calculators. It is OFF for every property until the agent opts in and
# enters a price ("Yatırım bilgileri" on the property page). With no key the player still shows
# the deterministic figures card — only the chat is hidden.
#
# What leaves the building: the agent's figures for the flat (price, rent, aidat, il/ilçe/
# mahalle — never the street address or the property's internal title) and the visitor's
# questions go to Anthropic. Conversations live in the engine's memory only, never on disk.
BIOSPHERE_ADVISOR_ENABLED=true

# Empty uses BIOSPHERE_LISTING_API_KEY, then ANTHROPIC_API_KEY.
# BIOSPHERE_ADVISOR_API_KEY=sk-ant-...

# Measured on 10 buyer questions (scripts/bench_advisor.py, 2026-10-06, basic web search):
#   claude-opus-5-5   low     $0.056 / question, median 10-13 s, every number traced
#   claude-opus-5-5   medium  $0.079 / question, median 14.7 s, every number traced
#   claude-sonnet-5-5 low     $0.031 / question, median 7.6 s, every number traced
#   claude-sonnet-5-5 medium  $0.029 / question, median 7.5 s, 2 numbers rounded by the model
#   claude-haiku-4-5          $0.015 / question, median 7.0 s, does its own arithmetic — avoid
BIOSPHERE_ADVISOR_MODEL=claude-sonnet-5-5
BIOSPHERE_ADVISOR_EFFORT=low

# Output ceiling of one call (thinking included), calls per question (the last one has tools
# switched off so it always ends in an answer), and web searches per call.
BIOSPHERE_ADVISOR_MAX_OUTPUT_TOKENS=8000
BIOSPHERE_ADVISOR_MAX_ROUNDS=4
BIOSPHERE_ADVISOR_MAX_SEARCHES_PER_CALL=3

# basic = web_search_20250305 (results in context, with citations — measured ~45 % faster);
# dynamic = web_search_20260209 (code filters the results first; no citations); auto = newest.
BIOSPHERE_ADVISOR_WEB_SEARCH=true
BIOSPHERE_ADVISOR_WEB_SEARCH_VERSION=basic
# Restrict searches to a JSON list of domains; empty = unrestricted.
# BIOSPHERE_ADVISOR_WEB_ALLOWED_DOMAINS=["tcmb.gov.tr","tuik.gov.tr","endeksa.com","emlakjet.com"]

# Retry a safety-classifier refusal on Anthropic's recommended fallback model (server side).
BIOSPHERE_ADVISOR_FALLBACKS=true

# Conversation limits. Each question re-reads the whole history, so long chats cost more.
BIOSPHERE_ADVISOR_MAX_TURNS=12
BIOSPHERE_ADVISOR_MAX_MESSAGE_CHARS=600
BIOSPHERE_ADVISOR_CONVERSATION_TTL_MINUTES=60
BIOSPHERE_ADVISOR_MAX_CONVERSATIONS=500
BIOSPHERE_ADVISOR_MAX_CONTEXT_TOKENS=80000

# Daily spending caps in USD (Europe/Istanbul day): per property (the agent may set a lower or
# higher one, up to the max) and across the installation. Over the cap the chat answers with
# a polite Turkish "today's limit is reached" and the figures card stays.
BIOSPHERE_ADVISOR_DAILY_BUDGET_USD=2.0
BIOSPHERE_ADVISOR_DAILY_BUDGET_MAX_USD=10.0
BIOSPHERE_ADVISOR_GLOBAL_DAILY_BUDGET_USD=25.0

# Questions per visitor IP (counted in memory against a salted digest — no IP is stored) and
# per property. Trust X-Forwarded-For only behind a proxy you control.
BIOSPHERE_ADVISOR_RATE_IP_PER_MINUTE=6
BIOSPHERE_ADVISOR_RATE_IP_PER_HOUR=40
BIOSPHERE_ADVISOR_RATE_PROPERTY_PER_HOUR=150
BIOSPHERE_ADVISOR_TRUST_FORWARDED_FOR=false
BIOSPHERE_ADVISOR_MAX_CONCURRENT=8
BIOSPHERE_ADVISOR_TIMEOUT_S=120.0

# Turkish purchase-cost parameters (tapu harcı, döner sermaye, commission, KDV, the example
# mortgage rate, BDDK's LTV bands, ...) as a JSON object overriding the dated defaults in
# biosphere/invest/rates.py. The dashboard shows the values in force with their sources.
# BIOSPHERE_ADVISOR_RATES={"doner_sermaye_tl": 7200, "mortgage_monthly_rate_pct": 2.79}

# ---------------------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------------------

# local | accounts. LOCAL by default: on your own machine the dashboard opens without a
# sign-in and acts as the installation's owner. Set `accounts` on any instance other people
# can reach — every private route then needs a sign-in again.
BIOSPHERE_AUTH_MODE=local

# Whether anybody may create an account, or only the operator through
# `biosphere user create`. Turning it off does not lock out people who already have an
# account, by either sign-in route — it only stops new ones being made.
BIOSPHERE_ALLOW_REGISTRATION=true

# Google sign-in. BOTH must be set for the button to appear; the login screen asks
# /api/v1/auth/google/status rather than guessing, so an installation without a Google
# project simply does not show it.
#
# Create them at console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client
# ID (Web application). Add the callback below to "Authorised redirect URIs" EXACTLY as it
# is sent — scheme, host, port, path. Google compares that string character for character
# and its error for a mismatch names no fix.
# BIOSPHERE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# BIOSPHERE_GOOGLE_CLIENT_SECRET=GOCSPX-...

# Left empty, the callback is {PUBLIC_BASE_URL}/api/v1/auth/google/callback. Set it when the
# engine sits behind a proxy on another hostname: what has to match in Google's console is
# the URL THE BROWSER visits, not the one the engine believes it is serving.
# BIOSPHERE_GOOGLE_REDIRECT_URL=https://app.example.com/api/v1/auth/google/callback

# ---- 3D walkthrough (biosphere/splat) ------------------------------------------------------
# The trainer and the SOG writer are not Python: Brush's release binary and
# @playcanvas/splat-transform are found under this directory (brush/brush_app.exe,
# node_modules/@playcanvas/splat-transform). BIOSPHERE_BRUSH_BIN overrides the first.
# BIOSPHERE_TOOLS_DIR=C:/biosphere-data/tools
# A Depth Anything 3 source checkout (its `src` dir) for the dense start of every area
# (splat/densify.py). Only the Apache-2.0 checkpoints are used (DA3-BASE by default); weights
# are read from BIOSPHERE_AI_MODELS_DIR/da3/DA3-BASE/{config.json,model.safetensors} or from a
# Hugging Face cache at BIOSPHERE_AI_MODELS_DIR/hf, fetched only when downloads are allowed.
# Missing, training starts from the SfM points as before.
# BIOSPHERE_DA3_SRC=C:/biosphere-data/tools/Depth-Anything-3/src
